DATABASE_URL=mysql+asyncmy://USER:PASSWORD@localhost:3306/noor_express
SECRET_KEY=change-me-user-jwt-secret
ADMIN_SECRET_KEY=change-me-admin-jwt-secret
ENV=development
ENABLE_DEV_SIMULATIONS=true
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_CODE_DEV=1234
REDIS_URL=redis://localhost:6379/0
REALTIME_STORE_BACKEND=memory
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
